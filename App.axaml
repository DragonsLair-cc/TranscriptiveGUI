<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="linux_desktop.App"
             xmlns:local="using:linux_desktop"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
             
    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="Axiforma">avares://linux_desktop/Assets/Fonts/Axiforma-Regular.ttf#Axiforma-Regular</FontFamily>
            <FontFamily x:Key="AxiformaBold">avares://linux_desktop/Assets/Fonts/Axiforma-Bold.ttf#Axiforma-Bold</FontFamily>
        
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="Background" Color="#FAFAFA"/>
                    <SolidColorBrush x:Key="Shell" Color="#D1D1D1"/>
                </ResourceDictionary>
                
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="Background" Color="#101011"/>
                    <SolidColorBrush x:Key="Shell" Color="#1F1F1F"/>
                    <SolidColorBrush x:Key="Text" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="Border" Color="#2E2E2E"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
        
    </Application.Resources>
             
    <Application.Styles>
        <FluentTheme/>
        <StyleInclude Source="avares://linux_desktop/Styles/ControlStyles.axaml"/>
    </Application.Styles>
             
</Application>